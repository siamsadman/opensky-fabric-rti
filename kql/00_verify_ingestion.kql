// 00_verify_ingestion.kql - run in the eh_opensky queryset, one statement at a time

.show tables

aircraft_states
| getschema

aircraft_states
| count

// Row count and time range in one result (used for screenshot 04)
aircraft_states
| summarize rows = count(), first_event = min(EventEnqueuedUtcTime), last_event = max(EventEnqueuedUtcTime)
