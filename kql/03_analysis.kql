// 03_analysis.kql - analysis queries, run one at a time

// Q1: distinct aircraft per 5-minute window (all vs airborne)
aircraft_clean()
| summarize aircraft = dcount(icao24), airborne = dcountif(icao24, not(on_ground)) by bin(position_time, 5m)
| order by position_time asc
| render timechart

// Q2: top 10 origin countries (registration country inferred from the ICAO address, not flight location)
aircraft_clean()
| summarize aircraft = dcount(icao24), readings = count(), airborne_pct = round(100.0 * countif(not(on_ground)) / count(), 1) by origin_country
| top 10 by aircraft desc

// Q3a: vertical-rate distribution of airborne aircraft (m/s, negative = descending) - used to choose an alert threshold
aircraft_clean()
| where not(on_ground) and isnotnull(vertical_rate_ms)
| summarize readings = count(), p01 = percentile(vertical_rate_ms, 1), p05 = percentile(vertical_rate_ms, 5), p50 = percentile(vertical_rate_ms, 50), p95 = percentile(vertical_rate_ms, 95), p99 = percentile(vertical_rate_ms, 99), min_vr = min(vertical_rate_ms), max_vr = max(vertical_rate_ms)

// Q3b: emergency squawk codes (7500, 7600, 7700)
aircraft_clean()
| where squawk in ("7500", "7600", "7700")
| project position_time, icao24, callsign, origin_country, squawk, latitude, longitude, baro_altitude_m
| order by position_time desc

// Q4: how often would candidate rapid-descent thresholds fire (m/s, negative = descending) - used to pick the alert rule
aircraft_clean()
| where not(on_ground) and isnotnull(vertical_rate_ms)
| summarize readings = count(),
            below_minus15 = countif(vertical_rate_ms < -15),
            below_minus20 = countif(vertical_rate_ms < -20),
            below_minus25 = countif(vertical_rate_ms < -25),
            aircraft_below_minus20 = dcountif(icao24, vertical_rate_ms < -20),
            minutes_of_data = datetime_diff('minute', max(position_time), min(position_time))

// Q5: do reported rapid descents (below -20 m/s) agree with the altitude change between consecutive readings? (tolerance 5 m/s is my choice)
aircraft_clean()
| where not(on_ground) and isnotnull(baro_altitude_m) and isnotnull(vertical_rate_ms)
| sort by icao24 asc, position_time asc
| extend prev_icao = prev(icao24), prev_time = prev(position_time), prev_alt = prev(baro_altitude_m)
| where prev_icao == icao24
| extend dt_s = datetime_diff('second', position_time, prev_time)
| where dt_s between (5 .. 120)
| extend computed_vr = (baro_altitude_m - prev_alt) / dt_s
| where vertical_rate_ms < -20
| summarize hits = count(),
            consistent = countif(abs(vertical_rate_ms - computed_vr) <= 5),
            inconsistent = countif(abs(vertical_rate_ms - computed_vr) > 5)
// Result on the final data (queried 27 Oct 2026): hits 23, consistent 4, inconsistent 19. An earlier run on partial data (about 85 minutes) gave 12 / 2 / 10.

// Q6: gaps longer than 90 s between consecutive OpenSky snapshots, since the 10:43 UTC producer restart
aircraft_states
| where EventEnqueuedUtcTime >= datetime(2026-10-25 10:43:00)
| summarize rows = count() by snapshot_time = todatetime(snapshot_utc)
| sort by snapshot_time asc
| extend prev_snapshot = prev(snapshot_time)
| extend gap_s = datetime_diff('second', snapshot_time, prev_snapshot)
| where gap_s > 90
| project prev_snapshot, snapshot_time, gap_s

// Q7: final counts after the producer was stopped
print raw_rows = toscalar(aircraft_states | count),
      first_event = toscalar(aircraft_states | summarize min(EventEnqueuedUtcTime)),
      last_event = toscalar(aircraft_states | summarize max(EventEnqueuedUtcTime)),
      unique_positions = toscalar(aircraft_clean() | count),
      distinct_aircraft = toscalar(aircraft_clean() | summarize dcount(icao24))

// Q8: gaps above 90 s between snapshots in rows received 10:16-11:00 UTC (finds the producer restart gap)
aircraft_states
| where EventEnqueuedUtcTime between (datetime(2026-10-25 10:16:00) .. datetime(2026-10-25 11:00:00))
| summarize rows = count() by snapshot_time = todatetime(snapshot_utc)
| sort by snapshot_time asc
| extend prev_snapshot = prev(snapshot_time)
| extend gap_s = datetime_diff('second', snapshot_time, prev_snapshot)
| where gap_s > 90
| project prev_snapshot, snapshot_time, gap_s

// Q9: cross-check of the Power BI report measures against the final data (queried 27 Oct 2026). Result: 46,004 / 1,088 / 1,081 / 26 / 21, matching the report.
print position_rows = toscalar(aircraft_clean() | count),
      distinct_aircraft = toscalar(aircraft_clean() | distinct icao24 | count),
      airborne_aircraft = toscalar(aircraft_clean() | where not(on_ground) | distinct icao24 | count),
      readings_below_m20 = toscalar(aircraft_clean() | where not(on_ground) and vertical_rate_ms < -20 | count),
      aircraft_below_m20 = toscalar(aircraft_clean() | where not(on_ground) and vertical_rate_ms < -20 | distinct icao24 | count)
